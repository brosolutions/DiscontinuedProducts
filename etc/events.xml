<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_before">
        <observer name="brosolutions_discontinuedproducts_validate_redirect_sku"
                  instance="BroSolutions\DiscontinuedProducts\Observer\ValidateRedirectSku" />
    </event>
    <event name="catalog_product_is_salable_after">
        <observer name="brosolutions_discontinuedproducts_disable_salable"
                  instance="BroSolutions\DiscontinuedProducts\Observer\DisableSalableForDiscontinuedProduct" />
    </event>
</config>
