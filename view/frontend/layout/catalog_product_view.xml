<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.main">
            <block class="BroSolutions\DiscontinuedProducts\Block\Product\View\DiscontinuedNotice"
                   name="discontinued.products.notice"
                   template="BroSolutions_DiscontinuedProducts::product/view/discontinued_notice.phtml"
                   before="product.info"
                   ifconfig="brosolutions_discontinued_products/general/enable" />
        </referenceContainer>
        <referenceBlock name="main">
            <block class="BroSolutions\DiscontinuedProducts\Block\Product\Replacement\ListProducts"
                   name="catalog.product.replacement"
                   template="BroSolutions_DiscontinuedProducts::product/list/items.phtml"
                   ifconfig="brosolutions_discontinued_products/general/enable">
                <arguments>
                    <argument name="view_model" xsi:type="object">Magento\Catalog\ViewModel\Product\Listing\PreparePostData</argument>
                </arguments>
                <block class="Magento\Catalog\Block\Product\ProductList\Item\Container" name="related.product.addto" as="addto">
                </block>
            </block>
        </referenceBlock>
    </body>
</page>
